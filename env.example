# Gateway Configuration
UPSTREAM_BASE=http://127.0.0.1:11434

# Optional Model Hub registration.
# Leave MODEL_HUB_REGISTER_URL empty to disable registration.
MODEL_HUB_REGISTER_URL=
MODEL_HUB_SERVICE_ID=ollama-server
MODEL_HUB_SERVICE_NAME=Ollama Server
MODEL_HUB_SERVICE_BASE_URL=http://ollama-server:11434
MODEL_HUB_SERVICE_GATEWAY_URL=http://ollama-server:11535
MODEL_HUB_SERVICE_ROLE=generate

# Settings (optional)
# UPSTREAM_STARTUP_TIMEOUT_SEC=30
# DISCONNECT_POLL_SEC=0.1
